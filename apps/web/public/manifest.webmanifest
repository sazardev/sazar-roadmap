{
  "id": "/",
  "name": "Sazar Roadmap",
  "short_name": "Roadmap",
  "description": "A private learning operating system: guided roadmaps, deliberate practice, spaced review and an AI coach.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f6f5f1",
